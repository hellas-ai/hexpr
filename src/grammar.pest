WHITESPACE = _{ " " | "\t" | "\n" | "\r" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }

hexprs = { SOI ~ hexpr* ~ EOI }
one_hexpr = { SOI ~ hexpr ~ EOI }

hexpr = {
    composition
  | tensor
  | frobenius
  | wire
  | hole
  | operation
}

composition = { "(" ~ hexpr* ~ ")" }

tensor = { "{" ~ hexpr* ~ "}" }

frobenius = { "[" ~ vars ~ ( "." ~ vars)? ~ "]" }

vars = { lvar* }

lvar = { variable ~ ( "^" ~ hexpr )? }

wire = { "^" ~ hexpr }

hole = { "_" }

operation = @{ (ASCII_ALPHANUMERIC | "-" | "_" | "." | "*" | "+" | "/" | "|" | ">" | "<" | ":" | "=" | "!" | "?")+ }

variable = @{ (ASCII_ALPHANUMERIC | "-" | "_") ~ (ASCII_ALPHANUMERIC | "-" | "_")* }
